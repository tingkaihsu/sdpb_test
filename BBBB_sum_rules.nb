          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"2", "t"}], "s"]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
