   RowBox[{
    RowBox[{
     RowBox[{"DblCtrSum", "[", 
      RowBox[{"s_", ",", "J_", ",", "k_", ",", "q_"}], "]"}], ":=", 
     RowBox[{"Residue", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
