Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Double", " ", "Contour", " ", "Integral"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"DblCtrSum", "[", 
      RowBox[{"s_", ",", "J_", ",", "k_", ",", "q_"}], "]"}], ":=", 
     RowBox[{"Residue", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"s", "*", "t"}]], "*", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", 
              RowBox[{
               RowBox[{"s", "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "q"}], ")"}]}], "*", 
               RowBox[{"t", "^", "q"}]}]], "-", 
             FractionBox["1", 
              RowBox[{
               RowBox[{"s", "^", "q"}], "*", 
               RowBox[{"t", "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "q"}], ")"}]}]}]]}], ")"}]}], "-", 
          RowBox[{
           FractionBox["1", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "s"}], "-", "t"}], ")"}], "*", "t"}]], "*", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "s"}], "-", "t"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "q"}], ")"}]}], "*", 
               RowBox[{"t", "^", "q"}]}]], "-", 
