                  RowBox[{"-", "s"}], "-", "t"}], ")"}], "^", "q"}], "*", 
               RowBox[{"t", "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "q"}], ")"}]}]}]]}], ")"}]}]}], ")"}], "*", 
        FractionBox[
         RowBox[{
          RowBox[{"(", "s", ")"}], "^", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{"10", "-", "3"}], "2"], ")"}]}], 
         RowBox[{"Sqrt", "[", "s", "]"}]], "*", 
        RowBox[{"PartialWaveD", "[", 
         RowBox[{"10", ",", "J", ",", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"2", "t"}], "s"]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xkq", "[", 
      RowBox[{"z_", ",", "J_", ",", "k_", ",", "q_"}], "]"}], " ", ":=", " ", 
