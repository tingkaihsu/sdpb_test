(* Content-type: application/vnd.wolfram.mathematica *)
(*** Wolfram Notebook File ***)
(* CreatedBy='Wolfram 15.0' *)

Notebook[{
Cell["10D ABAB dispersion-relation checks", "Title"],
Cell["B is massless and A has mass m, hence s+t+u=2 m^2. The fixed-t ABAB dispersion relation and the independently crossed AA -> BB partial-wave expansion are kept separate.", "Text"],

Cell["Low-energy amplitude", "Section"],
Cell[BoxData[
"ClearAll[g, gABAB, vldPairs, MABAB, lowEnergyKernel];\n+\n+g[a_, b_] := gABAB @@ Sort[{a, b}];\n+\n+vldPairs[Nmax_Integer?NonNegative] :=\n+  Flatten[Table[{a, b}, {a, 0, Nmax}, {b, 0, Nmax - a}], 1];\n+\n+MABAB[s_, t_, m_, Nmax_Integer?NonNegative] :=\n+  Total[\n+    Function[ab,\n+      g[ab[[1]], ab[[2]]] (u - m^2)^ab[[1]] (s - m^2)^ab[[2]]\n+    ] /@ vldPairs[Nmax]\n+  ] /. u -> 2 m^2 - s - t;\n+\n+lowEnergyKernel[s_, t_, m_, s1_, s2_, k_, Nmax_Integer?NonNegative] :=\n+  MABAB[s, t, m, Nmax]/\n+    ((s - s1) ((s - s1) (s - s2))^(k/2));"], "Input"],
Cell["This k=0 residue is an algebraic coefficient check, not a proof that an unsubtracted dispersion relation converges.", "Text"],
Cell[BoxData[
"lowEnergyG0Check = Series[\n+  -Residue[lowEnergyKernel[s, t, m, m^2, m^2 - t, 0, 10],\n+    {s, Infinity}],\n+  {t, 0, 2}\n+];\n+lowEnergyG0Check"], "Input"],

Cell["10D phase space, partial waves, and kinematics", "Section"],
Cell[BoxData[
"ClearAll[phaseABAB10, phaseAABB10, P10, spinMultiplicity10,\n+  zABAB10, zAABB10, uCrossed10, aabbForwardT10];\n+\n+(* Positive convention-dependent overall constants are omitted. *)\n+phaseABAB10[s_, m_] := (s - m^2)^7/s^4;\n+phaseAABB10[s_, m_] := s^(5/4) (s - 4 m^2)^(7/4);\n+\n+(* D=10 gives nu=(D-3)/2=7/2 and P10[J,1]=1. *)\n+P10[J_, z_] := GegenbauerC[J, 7/2, z]/GegenbauerC[J, 7/2, 1];\n+\n+spinMultiplicity10[J_Integer?NonNegative] :=\n+  (2 J + 7) Factorial[J + 6]/(Factorial[7] Factorial[J]);\n+\n+zABAB10[s_, t_, m_] := 1 + 2 s t/(s - m^2)^2;\n+zAABB10[s_, t_, m_] :=\n+  (2 t + s - 2 m^2)/Sqrt[s (s - 4 m^2)];\n+uCrossed10[s_, t_, m_] := 2 m^2 - s - t;\n+\n+(* The AA -> BB forward point in that channel's own variables. *)\n+aabbForwardT10[s_, m_] :=\n+  (2 m^2 - s + Sqrt[s (s - 4 m^2)])/2;"], "Input"],

Cell["Correct fixed-t ABAB dispersive kernel", "Section"],
Cell["After converting the left cut with s-u crossing, both Cauchy-kernel terms multiply the same physical ABAB absorptive partial wave. The AABB phase and angle do not replace the crossed ABAB block.", "Text"],
Cell[BoxData[
"ClearAll[subtractionKernel10, spectralABAB10, spectralAABB10,\n+  dispersionKernelABAB10];\n+\n+subtractionKernel10[x_, s1_, s2_, k_] :=\n+  1/((x - s1) ((x - s1) (x - s2))^(k/2));\n+\n+spectralABAB10[s_, t_, m_, J_] :=\n+  phaseABAB10[s, m] P10[J, zABAB10[s, t, m]];\n+\n+(* Independent coupled-channel building block; not used below. *)\n+spectralAABB10[s_, t_, m_, J_] :=\n+  phaseAABB10[s, m] P10[J, zAABB10[s, t, m]];\n+\n+(* [K(s')-K(2m^2-s'-t)] Im T_ABAB(s',t). *)\n+dispersionKernelABAB10[s_, t_, m_, k_, J_] := With[\n+  {s1loc = m^2, s2loc = m^2 - t, uloc = uCrossed10[s, t, m]},\n+  spectralABAB10[s, t, m, J] (\n+    subtractionKernel10[s, s1loc, s2loc, k] -\n+    subtractionKernel10[uloc, s1loc, s2loc, k]\n+  )\n+];"], "Input"],

Cell["0-sub diagnostic and twice-subtracted paper kernel", "Section"],
Cell["Here k=0 contains one denominator factor and is only a diagnostic. The paper's twice-subtracted Cauchy kernel has three denominator factors, corresponding to k=2 in this parameterization.", "Text"],
Cell[BoxData[
"assumptionsABAB10 = m > 0 && s > m^2 &&\n+  Element[{s, m}, Reals] && Element[J, Integers] && J >= 0;\n+\n+zeroSubABAB10 = FullSimplify[\n+  dispersionKernelABAB10[s, 0, m, 0, J],\n+  Assumptions -> assumptionsABAB10];\n+\n+paperTwoSubtractedABAB10 = FullSimplify[\n+  dispersionKernelABAB10[s, 0, m, 2, J],\n+  Assumptions -> assumptionsABAB10];\n+\n+expectedZeroSubABAB10 = 2 (s - m^2)^6/s^4;\n+expectedPaperKernelABAB10 = 2 (s - m^2)^4/s^4;\n+\n+{\n+  zeroSubABAB10,\n+  FullSimplify[zeroSubABAB10 == expectedZeroSubABAB10,\n+    Assumptions -> assumptionsABAB10],\n+  paperTwoSubtractedABAB10,\n+  FullSimplify[paperTwoSubtractedABAB10 == expectedPaperKernelABAB10,\n+    Assumptions -> assumptionsABAB10],\n+  FreeQ[zeroSubABAB10, J],\n+  FreeQ[paperTwoSubtractedABAB10, J]\n+}"], "Input"],
Cell["Expected output: {2 (s-m^2)^6/s^4, True, 2 (s-m^2)^4/s^4, True, True, True}. Thus the forward ABAB result has no spin dependence.", "Text"],

Cell["Separate AABB diagnostic", "Section"],
Cell["At global t=0 the AABB angle exceeds one; this is not the AABB forward point. Its Gegenbauer polynomial therefore retains J dependence. This analytically continued AABB block is not part of the fixed-t ABAB sum rule above.", "Text"],
Cell[BoxData[
"assumptionsAABB10 = m > 0 && s > 4 m^2 &&\n+  Element[{s, m}, Reals] && Element[J, Integers] && J >= 0;\n+\n+aabbAngleAtGlobalT0 = FullSimplify[zAABB10[s, 0, m],\n+  Assumptions -> assumptionsAABB10];\n+aabbGlobalT0IsOutsidePhysicalAngle = FullSimplify[\n+  aabbAngleAtGlobalT0 > 1, Assumptions -> assumptionsAABB10];\n+aabbOwnForwardCheck = FullSimplify[\n+  zAABB10[s, aabbForwardT10[s, m], m],\n+  Assumptions -> assumptionsAABB10];\n+\n+(* Threshold estimate:\n+   phaseAABB10 P10[J,zAABB10] ~ (s-4m^2)^(7/4-J/2). *)\n+aabbThresholdExponent10[J_] := 7/4 - J/2;\n+\n+{aabbAngleAtGlobalT0, aabbGlobalT0IsOutsidePhysicalAngle,\n+  aabbOwnForwardCheck, aabbThresholdExponent10[J]}"], "Input"],

Cell["Implementation note", "Section"],
Cell["Use dispersionKernelABAB10 for fixed-t ABAB dual-bootstrap constraints. Include spinMultiplicity10 in the spectral measure, or absorb it consistently into the positive spectral variable. Use spectralAABB10 only in a separately derived coupled-channel unitarity matrix, with threshold s>=4m^2 and even-spin selection.", "Text"]
},
WindowSize->{1152, 700},
Magnification:>1.25 Inherited,
